#!/bin/sh
# Keeps the build playable. Install with:  node tools/hooks/install.mjs
#
# Bypass:  SKIP_SMOKE=1 git push
# A bypass must be recorded with a  Smoke-Skipped: <reason>  commit trailer.
if [ -n "$SKIP_SMOKE" ]; then
  echo "pre-push: smoke test skipped (SKIP_SMOKE set)"
  echo "pre-push: add a 'Smoke-Skipped: <reason>' trailer to the commit"
  exit 0
fi
if [ ! -d "tools/node_modules" ]; then
  echo "pre-push: tools/node_modules missing, skipping (run npm install in tools/)"
  exit 0
fi
# The node half: bundle sync, pinned arithmetic, the movement budget, the camera
# and input table, a five-minute soak per golden seed. Seconds, and it catches
# most real regressions. The browser half is CI's job (issue #25) — a local gate
# that takes a minute is a local gate that gets bypassed, which it was, twice.
echo "pre-push: running smoke test…"
node tools/smoke.mjs --node || {
  echo ""
  echo "pre-push: BLOCKED — the build is not in a playable state."
  echo "pre-push: fix it, or SKIP_SMOKE=1 git push with a Smoke-Skipped trailer."
  exit 1
}
echo "pre-push: node half green. CI runs the whole browser half; to run only the"
echo "pre-push: groups this change can reach first:  node tools/smoke.mjs --browser --affected"
